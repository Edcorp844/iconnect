application_id = 'io.github.edcorp844.iconnect'

scalable_dir = 'hicolor' / 'scalable' / 'apps'
install_data(
  scalable_dir / ('@0@.svg').format(application_id),
  install_dir: get_option('datadir') / 'icons' / scalable_dir
)

symbolic_dir = 'hicolor' / 'symbolic' / 'apps'
install_data(
  symbolic_dir / ('@0@-symbolic.svg').format(application_id),
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'send-symbolic.svg',
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'new-message-symbolic.svg',
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'phone-apple-iphone-symbolic.svg',
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'iconnect-battery-level-symbolic.svg',
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'iconnect-bluetooth-symbolic.svg',
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'general-preferences-symbolic.svg',
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'call-preferences-symbolic.svg',
  install_dir: get_option('datadir') / 'icons' / symbolic_dir
)
install_data(
  symbolic_dir / 'privacy-preferences-symbolic.svg',
